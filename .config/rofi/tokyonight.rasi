/* ============================================================================
 * Cyberpunk HUD Theme for Rofi
 * Matches Waybar & Vesktop (#33ccff cyan / #00ff99 mint / #0b0f19 dark)
 * ========================================================================= */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    display-drun: "󰣇 RUN";
    display-run: " CMD";
    display-window: " WIN";
}

* {
    bg:          #0b0f19e0;
    bg-alt:      #111827cc;
    fg:          #c0caf5;
    fg-dim:      #565f89;
    cyan:        #33ccff;
    mint:        #00ff99;
    red:         #ff2a6d;
    selected-bg: #33ccff22;

    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 620px;
    background-color: @bg;
    border: 2px solid;
    border-color: @cyan;
    border-radius: 4px;
    padding: 14px;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border: 1px solid;
    border-color: #33ccff55;
    border-radius: 4px;
    padding: 10px 14px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @mint;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-dim;
    text-color: @fg;
    cursor-color: @cyan;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    spacing: 10px;
    border-radius: 4px;
    border: 0px 0px 0px 2px solid;
    border-color: transparent;
    background-color: transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected-bg;
    border-color: @cyan;
    text-color: @mint;
}

element normal.urgent,
element alternate.urgent {
    text-color: @red;
}

element selected.urgent {
    background-color: #ff2a6d22;
    border-color: @red;
    text-color: @red;
}

element-icon {
    size: 20px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
